# ===================================================
# BACKEND ENVIRONMENT VARIABLES FOR RAILWAY / PRODUCTION
# ===================================================

# Railway automatically sets PORT (no need to define it manually)
# PORT=8080

# Railway MySQL provides these automatically when MySQL is added to the project:
# MYSQLHOST=
# MYSQLPORT=
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=

# Optional manual DB override:
# DB_URL=jdbc:mysql://${MYSQLHOST}:${MYSQLPORT}/${MYSQLDATABASE}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USERNAME=root
# DB_PASSWORD=tiger

# JWT Configuration (Optional, defaults provided):
# JWT_SECRET=9a4f2c8d3b7a1e6f45c8a0b3f267d8b1d4e6f3c8a9d2b5f8e3a9c8b5f6a8a3d9
# JWT_EXPIRATION=86400000

# Frontend URL for CORS (Comma-separated):
# CORS_ALLOWED_ORIGINS=https://frontend-btb-system-production.up.railway.app
